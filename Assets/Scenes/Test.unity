  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2cb12d5ed8591448bce4c80f656ac93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  apiUrl: https://api.openai.com/v1/chat/completions
  model: gpt-4o-mini
  systemPrompt: "\uB108\uB294 \uC0AC\uC6A9\uC790\uC640 \uB300\uD654\uB97C \uB098\uB204\uACE0
    VR \uC624\uBE0C\uC81D\uD2B8\uB97C \uB2E4\uB8F0 \uC218 \uC788\uB294 \uC5B4\uC2DC\uC2A4\uD134\uD2B8\uC57C.
    \uC0AC\uC6A9\uC790\uAC00 \uBB3B\uB294 \uC9C8\uBB38\uC744 \uC798 \uC774\uD574\uD558\uACE0
    \uC624\uBE0C\uC81D\uD2B8\uB4E4\uC744 \uC870\uC791\uD574\uC57C\uD560 \uC694\uCCAD\uC774\uBA74
    Tools\uB97C \uCC38\uACE0\uD574\uC11C \uD560 \uC218 \uC788\uB294 \uD589\uB3D9\uC744
    \uD558\uBA74 \uB3FC. \uADF8\uC5D0 \uB530\uB978 \uACB0\uACFC\uC5D0 \uB300\uD55C
    \uB300\uB2F5\uB3C4 \uB530\uB85C \uB9D0\uB85C \uD558\uACE0. \uB2E4\uB9CC TTS\uB85C
    \uB9D0\uD558\uAE30 \uC27D\uAC8C \uC9E7\uACE0 \uBA85\uD655\uD55C \uBB38\uC7A5\uD615\uC73C\uB85C
    \uB2F5\uD574\uC918. (3~4\uBB38\uC7A5 \uC815\uB3C4). \uD589\uB3D9\uC744 \uC218\uD589\uD560
    \uC218 \uC5C6\uC73C\uBA74 \uC218\uD589\uC774 \uC5B4\uB835\uB2E4\uACE0 \uB9D0\uD574\uC918.
    \"\uB9C8\uC9C0\uB9C9\uC5D0 \uB354 \uB3C4\uC640\uB4DC\uB9B4 \uAC70 \uC788\uC744\uAE4C\uC694?\"
    \uAC19\uC740 \uC7A1\uB2E4\uD55C \uB9D0\uC740 \uD558\uC9C0 \uB9C8. \uADF8\uB9AC\uACE0
    Tools \uAD00\uB828 \uC561\uC158\uC744 \uD588\uC73C\uBA74 \uC218\uD589\uD588\uB2E4\uB294
    \uB9D0\uAE4C\uC9C0 \uD574."
  interaction: {fileID: 965718957}
  injectSceneContext: 1
  includeTools: 1
  timeoutSeconds: 30
  OnAssistantMessage:
    m_PersistentCalls:
      m_Calls: []
  OnToolCalls:
    m_PersistentCalls:
      m_Calls: []
  OnBlockToolCall:
    m_PersistentCalls:
      m_Calls: []
  blockToolNames:
